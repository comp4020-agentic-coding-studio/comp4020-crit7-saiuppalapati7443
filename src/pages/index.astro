---
import { IDENTITY_COOKIE } from "../lib/identity";
import { derivePrinterStates, jobsForOwner } from "../lib/printjobs";
import "../styles.css";

const ownerId = Astro.cookies.get(IDENTITY_COOKIE)?.value ?? null;
const printerStates = derivePrinterStates();
const myJobs = ownerId ? jobsForOwner(ownerId) : [];

const releasable = (status: string) => status === "ready_to_release";
const cancellable = (status: string) => status === "ready_to_release" || status === "printing";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FastPrint ANU</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">FastPrint</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>FastPrint ANU</h1>

      <section aria-labelledby="identity-heading">
        <h2 id="identity-heading">Who you are</h2>
        <p>
          {
            ownerId ? (
              <>
                Signed in as <strong>{ownerId}</strong>.
              </>
            ) : (
              "Enter your ANU ID to submit and manage print jobs."
            )
          }
        </p>
        <form method="post" action="/api/identity">
          <label for="anu_id">ANU ID</label>
          <input
            id="anu_id"
            name="anu_id"
            required
            pattern="[uU]\d{7}"
            placeholder="u1234567"
            value={ownerId ?? ""}
          />
          <button>{ownerId ? "Change" : "Continue"}</button>
        </form>
      </section>

      <section aria-labelledby="printers-heading">
        <h2 id="printers-heading">Printers</h2>
        <ul id="printers">
          {
            printerStates.map((printer) => (
              <li data-printer-id={printer.id}>
                <strong>{printer.name}</strong> — {printer.libraryLocation} —{" "}
                <span data-field="status">
                  {printer.isOffline ? "offline" : printer.busy ? "busy" : "idle"}
                </span>{" "}
                (<span data-field="queue">{printer.queueDepth}</span> queued) — paper:{" "}
                {printer.paperLevel}
              </li>
            ))
          }
        </ul>
      </section>

      {
        ownerId && (
          <section aria-labelledby="submit-heading">
            <h2 id="submit-heading">Submit a job</h2>
            <form method="post" action="/api/jobs">
              <label for="file_name">File name</label>
              <input id="file_name" name="file_name" required maxlength="200" />
              <label for="page_count">Pages</label>
              <input id="page_count" name="page_count" type="number" min="1" max="500" required />
              <label>
                <input type="checkbox" name="color" /> Colour
              </label>
              <label>
                <input type="checkbox" name="duplex" /> Duplex
              </label>
              <button>Submit</button>
            </form>
          </section>
        )
      }

      {
        ownerId && (
          <section aria-labelledby="jobs-heading">
            <h2 id="jobs-heading">Your jobs</h2>
            <ul id="jobs">
              {myJobs.map((job) => (
                <li>
                  {job.fileName} ({job.pageCount}p{job.color ? ", colour" : ""}
                  {job.duplex ? ", duplex" : ""}) — {job.status}
                  {releasable(job.status) && (
                    <form method="post" action={`/api/jobs/${job.id}/release`}>
                      <label for={`printer-${job.id}`}>Release to</label>
                      <select id={`printer-${job.id}`} name="printer_id" required>
                        {printerStates.map((printer) => (
                          <option value={printer.id} disabled={printer.isOffline}>
                            {printer.name}
                            {printer.isOffline ? " (offline)" : ""}
                          </option>
                        ))}
                      </select>
                      <button>Release</button>
                    </form>
                  )}
                  {cancellable(job.status) && (
                    <form method="post" action={`/api/jobs/${job.id}/cancel`}>
                      <button>Cancel</button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
    <script>
      // The live half of the dashboard: subscribe to the SSE stream and
      // update printer status/queue counts as events arrive. Every form here
      // needs none of this — each POST + redirect re-renders the submitting
      // tab from SQLite; this stream is how every *other* open tab finds out.
      const source = new EventSource("/api/events");
      source.addEventListener("printers", (event) => {
        const printerStates = JSON.parse(event.data);
        for (const printer of printerStates) {
          const row = document.querySelector(`#printers li[data-printer-id="${printer.id}"]`);
          if (!row) continue;
          const status = row.querySelector('[data-field="status"]');
          const queue = row.querySelector('[data-field="queue"]');
          if (status) status.textContent = printer.isOffline ? "offline" : printer.busy ? "busy" : "idle";
          if (queue) queue.textContent = String(printer.queueDepth);
        }
      });
    </script>
  </body>
</html>
